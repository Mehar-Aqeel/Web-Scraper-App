APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# HTTP fetch settings
REQUEST_TIMEOUT=15
CONNECT_TIMEOUT=5
MAX_RESPONSE_SIZE=10485760
MAX_REDIRECTS=3
SCRAPER_USER_AGENT=UniversalWebDataExtractor/1.0 (+https://github.com/<your-username>/universal-web-data-extractor)

# Rate limiting
RATE_LIMIT_PER_IP_PER_MINUTE=20
PER_DOMAIN_REQUEST_DELAY_MS=500
GLOBAL_CONCURRENCY_LIMIT=20

# Robots.txt
ROBOTS_CACHE_TTL_SECONDS=3600

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Retry
MAX_RETRIES=1

# Results / cache
MAX_RESULT_ROWS=2000
DATABASE_URL=sqlite+aiosqlite:///./webextractor.db
